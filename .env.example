# Copy this file to .env and fill in the values. Never commit .env.
# Get the shared key from the team's password manager (see readme.md).

# OpenRouter API key, used by server-side code only. Never expose it to the
# browser: do not rename it with a VITE_ prefix or import it in frontend/.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
